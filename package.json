{
  "name": "kiro-code-reviewer-kiro-crew-app",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node scripts/bundle.mjs",
    "test": "vitest run --coverage",
    "lint": "eslint src test scripts && prettier --check .",
    "format": "eslint --fix src test scripts && prettier --write .",
    "smoke": "tsx scripts/smoke.ts",
    "agent-tools": "tsx scripts/agent-tools.ts && prettier --write app.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@smithy/core": "3.40.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tsconfig/node24": "24.0.6",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "4.1.12",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "4.1.12"
  }
}
